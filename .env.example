# Public browser configuration. The anon key is expected in a browser app;
# Row Level Security is what protects data.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Trusted local/server setup only. Never prefix these values with VITE_.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=YOUR_SERVER_SECRET_KEY
# Legacy projects may use SUPABASE_SERVICE_ROLE_KEY instead.
ADMIN_EMAIL=replace-me@example.invalid
# Intentionally too short: create-admin.js refuses to run until this is replaced.
ADMIN_PASSWORD=REPLACE_ME
